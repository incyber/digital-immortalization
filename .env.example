# LiveKit. The docker-compose dev server generates this exact key/secret pair.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Language model, served by Ollama's OpenAI-compatible endpoint.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b

# Vision model, called on Ollama's native endpoint.
VLM_BASE_URL=http://localhost:11434
VLM_MODEL=qwen2.5vl:3b

# Backends. mlx = Metal on Apple Silicon; faster-whisper on Linux.
STT_BACKEND=mlx
RENDERER_BACKEND=viseme

DATABASE_URL=sqlite+aiosqlite:///./avatar.db
REDIS_URL=redis://localhost:6379/0

# Origins allowed to call the gateway. Comma separated.
WEB_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Fallback language model, used when the primary runs out of quota mid-call.
# Any OpenAI-compatible endpoint. Leave the key empty to disable it.
#   Groq    https://api.groq.com/openai/v1        keys begin gsk_
#   xAI     https://api.x.ai/v1                   keys begin xai-
#   Gemini  https://generativelanguage.googleapis.com/v1beta/openai
FALLBACK_LLM_PROVIDER_NAME=groq
FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=llama-3.3-70b-versatile

# RunPod Serverless. The endpoint id is written here only after
# provision.py has read the stored settings back and confirmed them.
RUNPOD_API_KEY=
# LivePortrait, for base clips. Not a splat endpoint.
RUNPOD_ENDPOINT_ID=

# Gaussian splat workers, one per route: they are different images. Both
# default in config.py - reconstruction to the verified endpoint, generation to
# empty, because that image does not build yet and a build needing it is
# refused in words. Set these only to override.
# RUNPOD_SPLAT_RECONSTRUCT_ENDPOINT_ID=
# RUNPOD_SPLAT_GENERATE_ENDPOINT_ID=
# "fake" builds with no GPU; "runpod" is the real build.
SPLAT_BACKEND=fake
