# LiveKit. The docker-compose dev server generates this exact key/secret pair.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Language model, served by Ollama's OpenAI-compatible endpoint.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b

# Vision model, called on Ollama's native endpoint.
VLM_BASE_URL=http://localhost:11434
VLM_MODEL=qwen2.5vl:3b

# Backends. mlx = Metal on Apple Silicon; faster-whisper on Linux.
STT_BACKEND=mlx
RENDERER_BACKEND=viseme

DATABASE_URL=sqlite+aiosqlite:///./avatar.db
REDIS_URL=redis://localhost:6379/0
