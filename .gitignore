# Vercel local project link / secrets
vercel-app/.vercel
vercel-app/.env*

# Claude Code local-only settings
.claude/settings.local.json

# Local runtime artifacts from the CLI prototypes (never committed - contain
# real conversation content if the scripts are actually run)
mvp/memory.jsonl
mvp/crisis-log.jsonl
web/memory.jsonl
web/crisis-log.jsonl

# OS noise
Thumbs.db
.DS_Store

# Toolchain binaries fetched into the project rather than installed system-wide
.tools/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.db

# Local environment
.env
.env.local

# Generated avatar assets (source material and derived plates)
assets/

# The built web app, planted here by `make web-build` so the gateway can serve
# it from the same origin as the API. Generated output, not source: the source
# is apps/web. It is ignored here and still reaches the image, because the
# build context is governed by .dockerignore rather than by this file.
src/avatar/gateway/webroot/
